rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net - default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for secure validation
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) 
                    && request.resource.data.keys().hasAll(['name', 'avatar', 'bio', 'isOnline'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 100
                    && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 500
                    && request.resource.data.bio is string && request.resource.data.bio.size() <= 300
                    && request.resource.data.isOnline is bool;
                    
      allow update: if isOwner(userId)
                    && (request.resource.data.name is string && request.resource.data.name.size() <= 100)
                    && (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 500)
                    && (request.resource.data.bio is string && request.resource.data.bio.size() <= 300)
                    && (request.resource.data.isOnline is bool);

      // Messages nesting collection
      match /chats/{contactId}/messages/{messageId} {
        allow read, delete: if isOwner(userId) && isValidId(contactId);
        allow create, update: if isOwner(userId) 
                              && isValidId(contactId)
                              && request.resource.data.keys().hasAll(['id', 'sender', 'text', 'timestamp'])
                              && request.resource.data.id is string
                              && (request.resource.data.sender == 'user' || request.resource.data.sender == 'contact')
                              && request.resource.data.text is string && request.resource.data.text.size() <= 2000
                              && request.resource.data.timestamp is string;
      }

      // Statuses collection
      match /statuses/{statusId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && request.resource.data.keys().hasAll(['id', 'mediaType', 'content', 'timestamp'])
                              && request.resource.data.id is string
                              && (request.resource.data.mediaType == 'text' || request.resource.data.mediaType == 'image')
                              && request.resource.data.content is string && request.resource.data.content.size() <= 2000
                              && request.resource.data.timestamp is string;
      }

      // Call logs collection
      match /callLogs/{logId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && request.resource.data.keys().hasAll(['id', 'contactId', 'name', 'avatar', 'type', 'direction', 'timestamp'])
                              && request.resource.data.id is string
                              && request.resource.data.contactId is string
                              && request.resource.data.name is string
                              && request.resource.data.avatar is string
                              && (request.resource.data.type == 'voice' || request.resource.data.type == 'video')
                              && (request.resource.data.direction == 'incoming' || request.resource.data.direction == 'outgoing')
                              && request.resource.data.timestamp is string;
      }
    }
  }
}
